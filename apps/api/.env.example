# Runtime connection. On Neon use the pooled URL (host contains "-pooler", add &pgbouncer=true).
DATABASE_URL="postgresql://mentor:mentor@localhost:5433/mentor_apprentice?schema=public"
# Migrations connection. On Neon use the direct (non-pooled) URL. Locally same as DATABASE_URL.
DIRECT_URL="postgresql://mentor:mentor@localhost:5433/mentor_apprentice?schema=public"
JWT_SECRET="dev-jwt-secret-change-me"
PORT=3000
# Comma-separated list allowed, e.g. "https://app.vercel.app,http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"
ALLOW_VERIFICATION_STUB="true"
SESSION_JOIN_OPEN_MINUTES_BEFORE="15"
SESSION_JOIN_CLOSE_MINUTES_AFTER_END="30"

# Auth: stub (default, CI/e2e) or auth0. Stub is refused when NODE_ENV=production
# unless ALLOW_STUB_AUTH="true" (private environments only).
AUTH_MODE="stub"
AUTH0_DOMAIN=""
AUTH0_AUDIENCE=""
