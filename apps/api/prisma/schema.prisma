generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum Role {
  MENTOR
  APPRENTICE
  ADMIN
}

enum PublicationStatus {
  DRAFT
  READY
  PUBLISHED
  UNPUBLISHED
  SUSPENDED
}

enum LanguageStatus {
  ACTIVE
  DISABLED
}

enum CatalogueStatus {
  ACTIVE
  PENDING_APPROVAL
  DISABLED
}

enum TeachingLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExpertiseStatus {
  ACTIVE
  DISABLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AvailabilityRuleStatus {
  ACTIVE
  DISABLED
}

model User {
  id             String     @id @default(cuid())
  authProviderId String     @unique
  email          String     @unique
  emailVerified  Boolean    @default(false)
  displayName    String?
  timezone       String?
  locale         String?
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  roles         UserRole[]
  mentorProfile MentorProfile?
  verifications Verification[]

  @@map("users")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model MentorProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  headline          String?
  biography         String?
  generalLocation   String?
  timezone          String?
  profilePhotoUrl   String?
  hourlyRate        Decimal?          @db.Decimal(10, 2)
  currency          String?
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  languages MentorLanguage[]
  expertise MentorExpertise[]
  availabilityRules AvailabilityRule[]

  @@map("mentor_profiles")
}

model Language {
  id        String         @id @default(cuid())
  code      String         @unique
  name      String
  status    LanguageStatus @default(ACTIVE)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  mentors MentorLanguage[]

  @@map("languages")
}

model MentorLanguage {
  mentorProfileId String
  languageId      String

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  language      Language      @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@id([mentorProfileId, languageId])
  @@map("mentor_languages")
}

model SkillCategory {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String?
  status      CatalogueStatus @default(ACTIVE)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  skills Skill[]

  @@map("skill_categories")
}

model Skill {
  id          String          @id @default(cuid())
  categoryId  String
  slug        String          @unique
  name        String
  description String?
  status      CatalogueStatus @default(ACTIVE)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  category  SkillCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  expertise MentorExpertise[]

  @@map("skills")
}

model MentorExpertise {
  id               String          @id @default(cuid())
  mentorProfileId  String
  skillId          String
  yearsExperience  Int
  description      String?
  teachingLevel    TeachingLevel
  status           ExpertiseStatus @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  skill         Skill         @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([mentorProfileId, skillId])
  @@map("mentor_expertise")
}

model AvailabilityRule {
  id              String                 @id @default(cuid())
  mentorProfileId String
  dayOfWeek       DayOfWeek
  startTime       String
  endTime         String
  timezone        String
  status          AvailabilityRuleStatus @default(ACTIVE)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  @@unique([mentorProfileId, dayOfWeek, startTime])
  @@map("availability_rules")
}

enum VerificationType {
  IDENTITY
  CREDENTIAL
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  REQUIRES_REVIEW
}

enum VerificationProvider {
  STUB
}

model Verification {
  id                String               @id @default(cuid())
  userId            String
  type              VerificationType
  status            VerificationStatus   @default(NOT_STARTED)
  provider          VerificationProvider @default(STUB)
  providerReference String?
  submittedAt       DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("verifications")
}
