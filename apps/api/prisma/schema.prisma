generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum Role {
  MENTOR
  APPRENTICE
  ADMIN
}

enum PublicationStatus {
  DRAFT
  READY
  PUBLISHED
  UNPUBLISHED
  SUSPENDED
}

enum LanguageStatus {
  ACTIVE
  DISABLED
}

enum CatalogueStatus {
  ACTIVE
  PENDING_APPROVAL
  DISABLED
}

enum TeachingLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExpertiseStatus {
  ACTIVE
  DISABLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AvailabilityRuleStatus {
  ACTIVE
  DISABLED
}

model User {
  id             String     @id @default(cuid())
  authProviderId String     @unique
  email          String     @unique
  emailVerified  Boolean    @default(false)
  displayName    String?
  timezone       String?
  locale         String?
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  roles         UserRole[]
  mentorProfile MentorProfile?
  apprenticeProfile ApprenticeProfile?
  verifications Verification[]
  blocksInitiated UserBlock[] @relation("Blocker")
  blocksReceived  UserBlock[] @relation("Blocked")
  analyticsEvents AnalyticsEvent[]
  cancelledBookings Booking[] @relation("BookingCancelledBy")
  sessionsAbsent    Session[] @relation("SessionAbsentUser")
  sessionsReported  Session[] @relation("SessionReportedBy")
  sessionSummariesCreated SessionSummary[] @relation("SessionSummaryCreatedBy")
  sessionSummariesUpdated SessionSummary[] @relation("SessionSummaryUpdatedBy")

  @@map("users")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model MentorProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  headline          String?
  biography         String?
  generalLocation   String?
  timezone          String?
  profilePhotoUrl   String?
  hourlyRate        Decimal?          @db.Decimal(10, 2)
  currency          String?
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  languages MentorLanguage[]
  expertise MentorExpertise[]
  availabilityRules AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  bookings Booking[]

  @@map("mentor_profiles")
}

model Language {
  id        String         @id @default(cuid())
  code      String         @unique
  name      String
  status    LanguageStatus @default(ACTIVE)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  mentors MentorLanguage[]

  @@map("languages")
}

model MentorLanguage {
  mentorProfileId String
  languageId      String

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  language      Language      @relation(fields: [languageId], references: [id], onDelete: Restrict)

  @@id([mentorProfileId, languageId])
  @@map("mentor_languages")
}

model SkillCategory {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String?
  status      CatalogueStatus @default(ACTIVE)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  skills Skill[]

  @@map("skill_categories")
}

model Skill {
  id          String          @id @default(cuid())
  categoryId  String
  slug        String          @unique
  name        String
  description String?
  status      CatalogueStatus @default(ACTIVE)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  category  SkillCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  expertise MentorExpertise[]
  bookings  Booking[]

  @@map("skills")
}

model MentorExpertise {
  id               String          @id @default(cuid())
  mentorProfileId  String
  skillId          String
  yearsExperience  Int
  description      String?
  teachingLevel    TeachingLevel
  status           ExpertiseStatus @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  skill         Skill         @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([mentorProfileId, skillId])
  @@map("mentor_expertise")
}

model AvailabilityRule {
  id              String                 @id @default(cuid())
  mentorProfileId String
  dayOfWeek       DayOfWeek
  startTime       String
  endTime         String
  timezone        String
  status          AvailabilityRuleStatus @default(ACTIVE)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  @@unique([mentorProfileId, dayOfWeek, startTime])
  @@map("availability_rules")
}

enum AvailabilityExceptionType {
  UNAVAILABLE
}

model AvailabilityException {
  id              String                     @id @default(cuid())
  mentorProfileId String
  date            String
  startTime       String?
  endTime         String?
  type            AvailabilityExceptionType  @default(UNAVAILABLE)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  @@index([mentorProfileId, date])
  @@map("availability_exceptions")
}

enum VerificationType {
  IDENTITY
  CREDENTIAL
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  REQUIRES_REVIEW
}

enum VerificationProvider {
  STUB
}

model Verification {
  id                String               @id @default(cuid())
  userId            String
  type              VerificationType
  status            VerificationStatus   @default(NOT_STARTED)
  provider          VerificationProvider @default(STUB)
  providerReference String?
  submittedAt       DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("verifications")
}

model ApprenticeProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  shortBio        String?
  generalLocation String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("apprentice_profiles")
}

model UserBlock {
  id            String   @id @default(cuid())
  blockerUserId String
  blockedUserId String
  createdAt     DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockedUserId])
  @@map("user_blocks")
}

enum AnalyticsEventType {
  SKILL_SEARCH
  MENTOR_PROFILE_VIEW
  BOOKING_REQUESTED
  BOOKING_ACCEPTED
  BOOKING_DECLINED
  BOOKING_CANCELLED
  SESSION_JOINED
  SESSION_COMPLETED
  SESSION_NO_SHOW
  SESSION_TECH_FAILURE
  SESSION_CANCELLED
}

model AnalyticsEvent {
  id          String             @id @default(cuid())
  type        AnalyticsEventType
  actorUserId String?
  payload     Json
  createdAt   DateTime           @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@map("analytics_events")
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  CONFIRMED
  COMPLETED
  DECLINED
  CANCELLED
  NO_SHOW
}

model Booking {
  id                  String        @id @default(cuid())
  mentorProfileId     String
  apprenticeProfileId String
  skillId             String
  startAt             DateTime
  endAt               DateTime
  timezoneSnapshot    String
  status              BookingStatus @default(REQUESTED)
  apprenticeMessage   String?
  declineReason       String?
  cancelledByUserId   String?
  cancelReason        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  mentorProfile     MentorProfile     @relation(fields: [mentorProfileId], references: [id], onDelete: Restrict)
  apprenticeProfile ApprenticeProfile @relation(fields: [apprenticeProfileId], references: [id], onDelete: Restrict)
  skill             Skill             @relation(fields: [skillId], references: [id], onDelete: Restrict)
  cancelledBy       User?             @relation("BookingCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  session           Session?

  @@index([mentorProfileId, status, startAt])
  @@index([apprenticeProfileId, status, startAt])
  @@map("bookings")
}

enum SessionStatus {
  READY
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum SessionFailureReason {
  TECHNICAL_FAILURE
  NO_SHOW
}

enum VideoProvider {
  STUB
}

model Session {
  id                 String                @id @default(cuid())
  bookingId          String                @unique
  status             SessionStatus         @default(READY)
  videoProvider      VideoProvider         @default(STUB)
  externalRoomId     String
  joinUrl            String
  mentorJoinedAt     DateTime?
  apprenticeJoinedAt DateTime?
  startedAt          DateTime?
  endedAt            DateTime?
  failureReason      SessionFailureReason?
  absentUserId       String?
  reportedByUserId   String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  booking    Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  absentUser User?           @relation("SessionAbsentUser", fields: [absentUserId], references: [id], onDelete: SetNull)
  reportedBy User?           @relation("SessionReportedBy", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  summary    SessionSummary?

  @@index([status, createdAt])
  @@map("sessions")
}

model SessionSummary {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  summary         String
  nextStep        String?
  createdByUserId String
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy User    @relation("SessionSummaryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy User?   @relation("SessionSummaryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("session_summaries")
}
